  };
  b.addEventListener('click', () => set(b.getAttribute('aria-expanded') !== 'true'));
  $$('a', m).forEach(a => a.addEventListener('click', () => set(false)));
  addEventListener('keydown', e => { if (e.key === 'Escape' && m.classList.contains('open')) set(false); });
  matchMedia('(min-width:1240px)').addEventListener('change', e => e.matches && set(false));

  $('#toTop').addEventListener('click', () => scrollTo({ top: 0, behavior: REDUCED.matches ? 'auto' : 'smooth' }));
