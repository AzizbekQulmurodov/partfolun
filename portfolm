function initTerminal() {
  const body = $('#termBody'), input = $('#termInput'), chips = $('#termChips'), form = $('#termForm');
  const hist = []; let hi = 0;
  const P = 'visitor@aq:~$';
  const line = (t, cls = '') => { const d = document.createElement('div'); d.className = 'term-line ' + cls; d.textContent = t; body.appendChild(d); body.scrollTop = body.scrollHeight; return d; };
  const html = (h, cls = '') => { const d = document.createElement('div'); d.className = 'term-line ' + cls; d.innerHTML = h; body.appendChild(d); body.scrollTop = body.scrollHeight; };

  const C = {
    help() {
      ['Mavjud buyruqlar:', '  help          buyruqlar ro\'yxati', '  whoami        men haqimda qisqacha', '  about         batafsil tanishuv', '  skills        texnik ko\'nikmalar', '  projects      loyihalar (open <n> — case study)', '  contact       aloqa ma\'lumotlari', '  social        ijtimoiy tarmoqlar', '  game          Cyber Arcade\'ni ishga tushirish', '  sound on|off  ovoz effektlari', '  clear         terminalni tozalash']
        .forEach((t, i) => line(t, i ? '' : 'ok'));
    },
    whoami() { [CONFIG.fullName, 'Senior Full-Stack & Creative Frontend Developer', "Joylashuv: O'zbekiston · Tajriba: 4+ yil", 'Status: yangi loyihalar uchun ochiq ✔'].forEach((t, i) => line(t, i === 3 ? 'ok' : '')); },
    about() { ['Dasturlashga ishtiyoq bitta savoldan boshlangan: «Bu qanday ishlaydi?»', 'Bugun esa toza kod, yuqori unumdorlik va esda qolarli UI/UX bilan', "g'oyalarni ishlaydigan raqamli mahsulotlarga aylantiraman."].forEach(t => line(t)); },
    skills() { SKILLS.forEach(c => line(c.title.padEnd(21) + ': ' + c.items.map(i => i.n).join(', '))); },
    projects() {
      PROJECTS.forEach(p => { line(`[${p.id}] ${p.title}`); line('    ' + p.tags.join(' · '), 'dim'); });
      line("Case study uchun: open <raqam>", 'ok');
    },
    open(a) {
      const n = +a[0], p = PROJECTS.find(x => x.id === n);
      if (!p) return line('Foydalanish: open <1-' + PROJECTS.length + '>', 'err');
      line(`"${p.title}" ochilmoqda…`, 'ok'); setTimeout(() => App.openCase(n), 250);
    },
    contact() {
      html(`Email    : <a href="mailto:${CONFIG.email}">${CONFIG.email}</a>`);
      html(`Telegram : <a href="${CONFIG.telegram}" target="_blank" rel="noopener noreferrer">${CONFIG.telegram}</a>`);
      line("Yoki sahifadagi aloqa formasidan foydalaning ↓", 'dim');
    },
    social() {
      html(`GitHub   : <a href="${CONFIG.github}" target="_blank" rel="noopener noreferrer">${CONFIG.github}</a>`);
      html(`LinkedIn : <a href="${CONFIG.linkedin}" target="_blank" rel="noopener noreferrer">${CONFIG.linkedin}</a>`);
      html(`Telegram : <a href="${CONFIG.telegram}" target="_blank" rel="noopener noreferrer">${CONFIG.telegram}</a>`);
    },
    clear() { body.innerHTML = ''; },
    sound(a) {
      const v = (a[0] || '').toLowerCase();
      if (v !== 'on' && v !== 'off') return line('Foydalanish: sound on | sound off', 'err');
      App.setSound(v === 'on'); line('Ovoz effektlari: ' + (v === 'on' ? 'yoqildi' : "o'chirildi"), 'ok');
    },
    game() { line('Cyber Arcade yuklanmoqda…', 'ok'); setTimeout(() => App.openGame(), 300); },
    ls() { line('home/  about/  skills/  projects/  process/  experience/  services/  contact/'); },
    sudo() { line("Ruxsat berildi ✔  Azizbek bilan ishlash uchun 'contact' deb yozing 😉", 'ok'); },
    echo(a) { line(a.join(' ')); },
    exit() { line("Bu yerdan chiqib bo'lmaydi 😄  'clear' ni sinab ko'ring.", 'dim'); }
  };
  const names = Object.keys(C);

  function run(raw) {
    const v = raw.trim();
    const d = document.createElement('div'); d.className = 'term-line cmd';
    const p = document.createElement('span'); p.className = 'p'; p.textContent = P + ' ';
    d.append(p, document.createTextNode(raw)); body.appendChild(d);
    if (!v) return;
    hist.push(v); hi = hist.length;
    const [c, ...args] = v.split(/\s+/), name = c.toLowerCase();
    if (Object.prototype.hasOwnProperty.call(C, name)) C[name](args);
    else { line(`buyruq topilmadi: ${c}. 'help' deb yozing.`, 'err'); SFX.play('error'); }
    body.scrollTop = body.scrollHeight;
  }
  form.addEventListener('submit', e => { e.preventDefault(); const v = input.value; input.value = ''; run(v); });
  input.addEventListener('keydown', e => {
    if (e.key === 'ArrowUp') { e.preventDefault(); if (hi > 0) hi--; input.value = hist[hi] || ''; }
    else if (e.key === 'ArrowDown') { e.preventDefault(); if (hi < hist.length) hi++; input.value = hist[hi] || ''; }
    else if (e.key === 'Tab') { e.preventDefault(); const m = names.filter(n => n.startsWith(input.value.toLowerCase())); if (m.length === 1) input.value = m[0]; }
    else if (e.key === 'l' && e.ctrlKey) { e.preventDefault(); C.clear(); }
    else if (e.key.length === 1) SFX.play('key');
  });
  body.addEventListener('click', () => { if (!getSelection().toString()) input.focus({ preventScroll: true }); });

  ['help', 'whoami', 'skills', 'projects', 'contact', 'game'].forEach(c => {
    const b = document.createElement('button'); b.type = 'button'; b.textContent = c;
    b.addEventListener('click', () => { run(c); input.focus({ preventScroll: true }); });
    chips.appendChild(b);
  });
  line('AQ-OS v2.6 — interaktiv terminal ishga tushdi.', 'ok');
  line("Boshlash uchun 'help' deb yozing yoki quyidagi tugmalarni bosing.", 'dim');

  App.focusTerminal = () => {
    const w = $('#termWrap');
    $('#home').scrollIntoView({ behavior: REDUCED.matches ? 'auto' : 'smooth' });
    w.classList.add('flash'); setTimeout(() => w.classList.remove('flash'), 1200);
    setTimeout(() => input.focus({ preventScroll: true }), 450);
  };
}

/* =========================================================
   Aloqa formasi, nusxalash, CV, ijtimoiy havolalar
