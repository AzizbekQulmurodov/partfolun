function initForm() {
  const f = $('#contactForm');
  const rules = {
    name: v => v.trim().length >= 2 || "Ismingizni kiriting (kamida 2 belgi)",
    email: v => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim()) || "To'g'ri email manzil kiriting",
    subject: v => v.trim().length >= 3 || "Mavzuni yozing (kamida 3 belgi)",
    message: v => v.trim().length >= 10 || "Xabar kamida 10 belgidan iborat bo'lsin"
  };
  const check = n => {
    const el = f.elements[n], r = rules[n](el.value), box = el.closest('.field'), ok = r === true;
    box.classList.toggle('invalid', !ok); el.setAttribute('aria-invalid', String(!ok));
    $('#' + n + '-e').textContent = ok ? '' : r; return ok;
  };
  Object.keys(rules).forEach(n => {
    const el = f.elements[n];
    el.addEventListener('blur', () => { if (el.value || el.closest('.field').classList.contains('invalid')) check(n); });
    el.addEventListener('input', () => { if (el.closest('.field').classList.contains('invalid')) check(n); });
  });
  const cnt = $('#msgCount'); f.elements.message.addEventListener('input', e => { cnt.textContent = e.target.value.length + '/1000'; });

  f.addEventListener('submit', async e => {
    e.preventDefault();
    if (f.elements.company.value) return; // honeypot
    const ok = Object.keys(rules).map(check).every(Boolean);
    if (!ok) { SFX.play('error'); toast("Iltimos, formadagi xatolarni to'g'rilang", 'error'); const bad = f.querySelector('.invalid input,.invalid textarea'); bad && bad.focus(); return; }
    const data = { name: f.elements.name.value.trim(), email: f.elements.email.value.trim(), subject: f.elements.subject.value.trim(), message: f.elements.message.value.trim(), budget: (f.querySelector('input[name=budget]:checked') || {}).value || '—' };
    const btn = $('#sendBtn'), lbl = $('span', btn); btn.disabled = true; lbl.textContent = 'Yuborilmoqda…';
    const done = () => { f.reset(); cnt.textContent = '0/1000'; };
    if (CONFIG.formEndpoint) {
      try {
        const r = await fetch(CONFIG.formEndpoint, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(data) });
        if (!r.ok) throw new Error('http ' + r.status);
        SFX.play('success'); toast('Xabaringiz yuborildi! Tez orada javob beraman.', 'success'); done();
      } catch (err) { SFX.play('error'); toast("Yuborib bo'lmadi. Iltimos, email orqali yozing: " + CONFIG.email, 'error', 6000); }
    } else {
      const body = `Ism: ${data.name}\nEmail: ${data.email}\nByudjet: ${data.budget}\n\n${data.message}`;
      location.href = `mailto:${CONFIG.email}?subject=${encodeURIComponent(data.subject)}&body=${encodeURIComponent(body)}`;
      SFX.play('success'); toast("Pochta ilovangiz ochilmoqda — xabarni u yerdan yuboring.", 'success', 5500); done();
    }
    btn.disabled = false; lbl.textContent = 'Xabarni Yuborish';
  });

  $$('[data-subject]').forEach(a => a.addEventListener('click', () => { f.elements.subject.value = a.dataset.subject; }));

  $('#copyEmail').addEventListener('click', async () => {
    let ok = false;
    try { await navigator.clipboard.writeText(CONFIG.email); ok = true; }
    catch (e) {
      const t = document.createElement('textarea'); t.value = CONFIG.email; t.style.cssText = 'position:fixed;opacity:0';
      document.body.appendChild(t); t.select(); try { ok = document.execCommand('copy'); } catch (er) {} t.remove();
    }
    if (ok) { SFX.play('success'); toast('Email nusxalandi: ' + CONFIG.email, 'success', 2800); }
    else toast("Nusxalab bo'lmadi. Qo'lda nusxalang: " + CONFIG.email, 'error');
  });
}

