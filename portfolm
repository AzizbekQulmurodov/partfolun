/* Mini sintaksis bo'yash (bir o'tishda — xavfsiz) */
const KW = /^(const|let|var|function|return|import|from|export|default|async|await|new|type|true|false|SELECT|FROM|GROUP|BY|ORDER|LIMIT|AS|COUNT|COPY|CMD|GET|POST|DELETE|git|on|jobs)$/;
function highlight(src) {
  return src.replace(/(\/\/.*)|('(?:[^'\\]|\\.)*'|"(?:[^"\\]|\\.)*")|(\b[A-Za-z_]\w*\b)|(\b\d+\b)|([&<>])/g, (m, c, s, w, n, x) => {
    if (c) return `<span class="c">${esc(c)}</span>`;
    if (s) return `<span class="s">${esc(s)}</span>`;
    if (w) return KW.test(w) ? `<span class="k">${w}</span>` : w;
    if (n) return `<span class="n">${n}</span>`;
    return esc(x);
  });
}

