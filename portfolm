}

/* =========================================================
   🌌 Interactive Constellation Background
   ========================================================= */
function initBg() {
  const cv = $('#bg'), ctx = cv.getContext('2d');
  let W, H, dpr, pts = [], stars = [];
  const mouse = { x: -9999, y: -9999 };
  const LINK = 130, MR = 170;
  function build() {
    dpr = Math.min(devicePixelRatio || 1, 2);
    W = innerWidth; H = innerHeight;
    cv.width = W * dpr; cv.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const n = Math.min(Math.floor(W * H / 15000), W < 700 ? 42 : 105);
    pts = Array.from({ length: n }, () => ({ x: Math.random() * W, y: Math.random() * H, vx: (Math.random() - .5) * .4, vy: (Math.random() - .5) * .4, r: Math.random() * 1.4 + .6 }));
    stars = Array.from({ length: Math.floor(W * H / 9000) }, () => ({ x: Math.random() * W, y: Math.random() * H, r: Math.random() * .9 + .2, p: Math.random() * 6.28, s: Math.random() * .02 + .005 }));
    if (REDUCED.matches) frame(true);
  }
  function frame(still) {
    ctx.clearRect(0, 0, W, H);
    for (const s of stars) {
      if (!still) s.p += s.s;
      ctx.globalAlpha = .25 + .3 * Math.sin(s.p);
      ctx.fillStyle = '#9AA8C7';
      ctx.beginPath(); ctx.arc(s.x, s.y, s.r, 0, 6.283); ctx.fill();
    }
    ctx.globalAlpha = 1;
    for (const p of pts) {
      if (!still) {
        p.x += p.vx; p.y += p.vy;
        if (p.x < -10) p.x = W + 10; else if (p.x > W + 10) p.x = -10;
        if (p.y < -10) p.y = H + 10; else if (p.y > H + 10) p.y = -10;
        const dx = p.x - mouse.x, dy = p.y - mouse.y, d = Math.hypot(dx, dy);
        if (d < MR && d > 1) { const f = (1 - d / MR) * .9; p.x += dx / d * f; p.y += dy / d * f; }
      }
    }
    ctx.lineWidth = .7;
    for (let i = 0; i < pts.length; i++) {
      const a = pts[i];
      for (let j = i + 1; j < pts.length; j++) {
        const b = pts[j], d = Math.hypot(a.x - b.x, a.y - b.y);
        if (d < LINK) { ctx.strokeStyle = `rgba(0,217,255,${(1 - d / LINK) * .32})`; ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke(); }
      }
      const md = Math.hypot(a.x - mouse.x, a.y - mouse.y);
      if (md < MR) { ctx.strokeStyle = `rgba(37,130,255,${(1 - md / MR) * .65})`; ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(mouse.x, mouse.y); ctx.stroke(); }
      ctx.fillStyle = md < MR ? '#7fe9ff' : 'rgba(120,190,255,.75)';
      ctx.beginPath(); ctx.arc(a.x, a.y, a.r, 0, 6.283); ctx.fill();
    }
  }
  build();
  let rt; addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(build, 150); });
  if (REDUCED.matches) return;
  addEventListener('pointermove', e => { mouse.x = e.clientX; mouse.y = e.clientY; }, { passive: true });
  document.addEventListener('mouseleave', () => { mouse.x = mouse.y = -9999; });
  (function loop() { frame(false); requestAnimationFrame(loop); })();
}

