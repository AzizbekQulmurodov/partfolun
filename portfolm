    sb.setAttribute('aria-pressed', String(SFX.on));
    const t = 'Ovoz effektlari: ' + (SFX.on ? 'yoqilgan' : "o'chiq");
    sb.title = t; sb.setAttribute('aria-label', t);
    if (SFX.on) sb.classList.remove('pulse-hint');
  };
  App.setSound = v => { SFX.setEnabled(v); sync(); };
  sb.addEventListener('click', () => {
    App.setSound(!SFX.on); sb.classList.remove('pulse-hint');
    toast(SFX.on ? 'Kiber ovoz effektlari yoqildi 🔊' : "Ovoz effektlari o'chirildi 🔇", 'info', 2200);
  });
  sync();
  $('#termBtn').addEventListener('click', () => { SFX.play('open'); App.focusTerminal(); });

  const SND = 'a[href],button,.project,.service,.step,.skill-card,.t-item,.stat,.info-panel,.c-row,[data-sfx]';
  document.addEventListener('mouseover', e => { const el = e.target.closest && e.target.closest(SND); if (el && !el.contains(e.relatedTarget)) SFX.play('hover'); });
  document.addEventListener('click', e => { if (e.target.closest && e.target.closest('a[href],button')) SFX.play('click'); });
  addEventListener('pointerdown', () => SFX.unlock(), { passive: true });
}

/* =========================================================
   🕹️ Cyber Arcade (Space Invaders uslubida)
   ========================================================= */
function initGame() {
  const dlg = $('#gameDlg'), cv = $('#game'), ctx = cv.getContext('2d');
  const W = 480, H = 640;
  const HUD = { score: $('#gScore'), lives: $('#gLives'), level: $('#gLevel'), hi: $('#gHi') };
  const keys = { left: false, right: false, fire: false };
  let st = 'idle', raf = 0, last = 0, score = 0, lives = 3, level = 1, hi = +(store.get('aq-hi') || 0);
  let ship, bullets, enemies, ebullets, parts, dir, cool, ecool, inv, total, banner = null;
  const stars = Array.from({ length: 60 }, () => ({ x: Math.random() * W, y: Math.random() * H, s: Math.random() * 40 + 10, r: Math.random() * 1.3 + .3 }));
  const COLORS = ['#2563FF', '#00D9FF', '#7aa2ff', '#4fd1ff', '#2563FF', '#00D9FF'];

  function hud() {
    HUD.score.textContent = score; HUD.level.textContent = level; HUD.hi.textContent = hi;
    HUD.lives.textContent = '♥'.repeat(Math.max(lives, 0)) || '—';
  }
  function spawn() {
    enemies = []; const rows = Math.min(3 + level, 6);
    for (let r = 0; r < rows; r++) for (let c = 0; c < 8; c++) enemies.push({ x: 40 + c * 48, y: 70 + r * 38, r, dead: false });
    total = enemies.length; dir = 1;
  }
  function start() {
    score = 0; lives = 3; level = 1; ship = { x: W / 2, y: H - 56 };
    bullets = []; ebullets = []; parts = []; inv = 0; cool = 0; ecool = 1; banner = null;
    spawn(); st = 'play'; hud();
  }
  function burst(x, y, color, n = 14) {
    for (let i = 0; i < n; i++) { const a = Math.random() * 6.283, s = 40 + Math.random() * 160; parts.push({ x, y, vx: Math.cos(a) * s, vy: Math.sin(a) * s, life: .5 + Math.random() * .4, c: color }); }
  }
  function over() {
    st = 'over'; SFX.play('lose');
    if (score > hi) { hi = score; store.set('aq-hi', String(hi)); }
    hud();
  }
  function hurt() {
    lives--; inv = 1.8; burst(ship.x, ship.y, '#00D9FF', 24); SFX.play('hurt'); hud();
    if (lives <= 0) over();
  }
  function update(dt) {
    const mv = (keys.right ? 1 : 0) - (keys.left ? 1 : 0);
    ship.x = Math.max(22, Math.min(W - 22, ship.x + mv * 340 * dt));
    cool -= dt; if (keys.fire && cool <= 0) { bullets.push({ x: ship.x, y: ship.y - 16 }); cool = .3; SFX.play('shoot'); }
    inv = Math.max(0, inv - dt);
    bullets.forEach(b => b.y -= 560 * dt); bullets = bullets.filter(b => b.y > -20);

    const alive = enemies.filter(e => !e.dead);
    const sp = 34 + level * 7 + (1 - alive.length / total) * 110;
    let minX = 1e9, maxX = -1e9, maxY = 0;
    alive.forEach(e => { e.x += dir * sp * dt; minX = Math.min(minX, e.x); maxX = Math.max(maxX, e.x + 24); maxY = Math.max(maxY, e.y + 24); });
    if ((dir > 0 && maxX >= W - 10) || (dir < 0 && minX <= 10)) { dir *= -1; alive.forEach(e => e.y += 16); }
    if (maxY >= ship.y - 10) { over(); return; }

    for (const b of bullets) for (const e of alive) {
      if (!e.dead && b.y > e.y && b.y < e.y + 24 && b.x > e.x - 2 && b.x < e.x + 26) {
        e.dead = true; b.y = -99; score += 30 - Math.min(e.r, 2) * 10;
        burst(e.x + 12, e.y + 12, COLORS[e.r % 6]); SFX.play('boom'); hud(); break;
      }
    }
    enemies = enemies.filter(e => !e.dead);

    ecool -= dt;
    if (ecool <= 0 && enemies.length) {
      const e = enemies[Math.floor(Math.random() * enemies.length)];
      ebullets.push({ x: e.x + 12, y: e.y + 24 });
      ecool = Math.max(.35, 1.1 - level * .1) * (.6 + Math.random() * .8);
    }
    ebullets.forEach(b => b.y += (230 + level * 18) * dt);
    if (!inv) for (const b of ebullets) {
      if (Math.abs(b.x - ship.x) < 16 && b.y > ship.y - 12 && b.y < ship.y + 14) { b.y = H + 50; hurt(); break; }
    }
    ebullets = ebullets.filter(b => b.y < H + 20);

    if (st === 'play' && !enemies.length) {
      level++; score += 100; banner = { text: 'DARAJA ' + level, t: 1.6 }; SFX.play('win'); ebullets = []; spawn(); hud();
    }
  }
  function sprite(rows, x, y, s, color) {
    ctx.fillStyle = color;
    rows.forEach((r, j) => { for (let i = 0; i < r.length; i++) if (r[i] === '1') ctx.fillRect(x + i * s, y + j * s, s, s); });
  }
  function centerText(t, y, size, color) {
    ctx.font = `bold ${size}px "JetBrains Mono",monospace`; ctx.textAlign = 'center'; ctx.fillStyle = color; ctx.fillText(t, W / 2, y);
  }
  function draw(dt) {
    ctx.fillStyle = '#03050f'; ctx.fillRect(0, 0, W, H);
    ctx.fillStyle = '#9AA8C7';
    stars.forEach(s => { s.y += s.s * dt; if (s.y > H) { s.y = 0; s.x = Math.random() * W; } ctx.globalAlpha = s.r / 2; ctx.fillRect(s.x, s.y, s.r, s.r); });
    ctx.globalAlpha = 1;
    if (st !== 'idle') {
      enemies.forEach(e => sprite(e.r % 2 ? SPR_B : SPR_A, e.x, e.y, 3, COLORS[e.r % 6]));
      ctx.shadowColor = '#00D9FF'; ctx.shadowBlur = 12; ctx.fillStyle = '#F4F7FF';
      bullets.forEach(b => ctx.fillRect(b.x - 1.5, b.y, 3, 12));
      ctx.shadowColor = '#ff5a78'; ctx.fillStyle = '#ff7a90';
      ebullets.forEach(b => ctx.fillRect(b.x - 1.5, b.y, 3, 12));
      if (st === 'play' || st === 'pause') {
        if (!inv || Math.floor(performance.now() / 90) % 2) {
          ctx.shadowColor = '#00D9FF'; ctx.fillStyle = '#00D9FF';
          ctx.beginPath(); ctx.moveTo(ship.x, ship.y - 14); ctx.lineTo(ship.x + 18, ship.y + 12); ctx.lineTo(ship.x + 7, ship.y + 7); ctx.lineTo(ship.x - 7, ship.y + 7); ctx.lineTo(ship.x - 18, ship.y + 12); ctx.closePath(); ctx.fill();
        }
      }
      ctx.shadowBlur = 0;
      if (st === 'play') parts.forEach(p => { p.x += p.vx * dt; p.y += p.vy * dt; p.life -= dt; });
      parts = parts.filter(p => p.life > 0);
      parts.forEach(p => { ctx.globalAlpha = Math.min(1, p.life * 2); ctx.fillStyle = p.c; ctx.fillRect(p.x, p.y, 3, 3); });
      ctx.globalAlpha = 1;
    }
    if (banner) { banner.t -= dt; centerText(banner.text, H / 2, 30, '#00D9FF'); if (banner.t <= 0) banner = null; }
    if (st === 'idle') {
      centerText('CYBER ARCADE', H / 2 - 40, 34, '#00D9FF');
      centerText('Boshlash: Enter / Space', H / 2 + 6, 15, '#F4F7FF');
      centerText('yoki ekranga bosing', H / 2 + 30, 13, '#9AA8C7');
    } else if (st === 'over') {
      centerText("O'YIN TUGADI", H / 2 - 40, 32, '#ff7a90');
      centerText('Ball: ' + score + '  ·  Rekord: ' + hi, H / 2 + 4, 16, '#F4F7FF');
      centerText('Qayta boshlash: Enter', H / 2 + 36, 14, '#9AA8C7');
    } else if (st === 'pause') centerText('PAUZA', H / 2, 32, '#00D9FF');
  }
  function loop(ts) {
    raf = requestAnimationFrame(loop);
    const dt = Math.min((ts - last) / 1000 || 0, .05); last = ts;
    if (st === 'play') update(dt);
    draw(dt);
  }
  App.openGame = () => {
    openDlg(dlg); st = 'idle'; score = 0; lives = 3; level = 1; ship = { x: W / 2, y: H - 56 }; enemies = []; bullets = []; ebullets = []; parts = []; inv = 0; banner = null;
    hud(); last = performance.now(); cancelAnimationFrame(raf); raf = requestAnimationFrame(loop);
  };
  dlg.addEventListener('close', () => { cancelAnimationFrame(raf); Object.keys(keys).forEach(k => keys[k] = false); $$('.pad button').forEach(b => b.classList.remove('down')); });
  document.addEventListener('visibilitychange', () => { if (document.hidden && st === 'play' && dlg.open) st = 'pause'; });

  const KM = { ArrowLeft: 'left', a: 'left', A: 'left', ArrowRight: 'right', d: 'right', D: 'right', ' ': 'fire' };
  addEventListener('keydown', e => {
    if (!dlg.open) return;
    if (KM[e.key]) { keys[KM[e.key]] = true; if (e.key === ' ' || e.key.startsWith('Arrow')) e.preventDefault(); if (e.key === ' ' && (st === 'idle' || st === 'over')) start(); }
    else if (e.key === 'Enter' && (st === 'idle' || st === 'over')) start();
    else if ((e.key === 'p' || e.key === 'P') && (st === 'play' || st === 'pause')) st = st === 'play' ? 'pause' : 'play';
  });
  addEventListener('keyup', e => { if (!dlg.open) return; if (KM[e.key]) { keys[KM[e.key]] = false; if (e.key === ' ') e.preventDefault(); } });
  cv.addEventListener('pointerdown', () => { if (st === 'idle' || st === 'over') start(); else if (st === 'pause') st = 'play'; });
  $$('.pad button').forEach(b => {
    const k = b.dataset.k;
    const down = e => { e.preventDefault(); keys[k] = true; b.classList.add('down'); if (k === 'fire' && (st === 'idle' || st === 'over')) start(); };
    const up = () => { keys[k] = false; b.classList.remove('down'); };
    b.addEventListener('pointerdown', down);
    ['pointerup', 'pointerleave', 'pointercancel'].forEach(ev => b.addEventListener(ev, up));
  });
  $$('[data-game]').forEach(b => b.addEventListener('click', () => App.openGame()));
}

