function initReveal() {
  const els = $$('.reveal:not(.in)');
  if (!('IntersectionObserver' in window) || REDUCED.matches) { els.forEach(e => e.classList.add('in')); return; }
  const io = new IntersectionObserver(es => es.forEach(x => { if (x.isIntersecting) { x.target.classList.add('in'); io.unobserve(x.target); } }), { threshold: .12, rootMargin: '0px 0px -40px 0px' });
  els.forEach(e => io.observe(e));
}

function initCounters() {
  const run = el => {
    const to = +el.dataset.count, suf = el.dataset.suffix || '';
    if (REDUCED.matches) { el.textContent = to + suf; return; }
    const t0 = performance.now(), d = 1400;
    (function f(n) {
      const p = Math.min((n - t0) / d, 1), e = 1 - Math.pow(1 - p, 3);
      el.textContent = Math.round(to * e) + suf;
      if (p < 1) requestAnimationFrame(f);
    })(t0);
  };
  const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { run(e.target); io.unobserve(e.target); } }), { threshold: .6 });
  $$('[data-count]').forEach(el => io.observe(el));
}

function initSpot() {
  const fx = FINE.matches && !REDUCED.matches;
  document.addEventListener('pointermove', e => {
    const c = e.target.closest && e.target.closest('[data-spot]');
    if (!c) return;
    const r = c.getBoundingClientRect(), x = e.clientX - r.left, y = e.clientY - r.top;
    c.style.setProperty('--mx', x + 'px'); c.style.setProperty('--my', y + 'px');
    if (fx && c.classList.contains('tilt')) {
      const px = x / r.width - .5, py = y / r.height - .5;
      c.style.transform = `perspective(900px) rotateX(${(-py * 6).toFixed(2)}deg) rotateY(${(px * 8).toFixed(2)}deg)`;
    }
  }, { passive: true });
  document.addEventListener('pointerout', e => {
    const c = e.target.closest && e.target.closest('.tilt');
    if (c && !c.contains(e.relatedTarget)) c.style.transform = '';
  });
}

