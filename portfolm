    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([txt], { type: 'text/plain;charset=utf-8' }));
    a.download = 'Azizbek_Qulmurodov_CV.txt'; document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 1500);
    toast("CV yuklab olindi. PDF uchun CONFIG.cvUrl ga havola kiriting.", 'success', 5000);
  });
