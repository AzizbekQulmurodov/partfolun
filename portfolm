<style>
/* =========================================================
   AQ // PORTFOLIO — Futuristik Dark Theme
   ========================================================= */
:root{
  --bg:#050816;--bg2:#0A1020;--card:#0D1528;
  --blue:#2563FF;--cyan:#00D9FF;
  --text:#F4F7FF;--muted:#9AA8C7;
  --border:rgba(120,160,255,.18);
  --grad:linear-gradient(120deg,#2563FF,#00D9FF);
  --ff:'Space Grotesk',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
  --mono:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  --display:'Orbitron','Space Grotesk',system-ui,sans-serif;
  --nav-h:72px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:calc(var(--nav-h) + 10px)}
html.dlg-open,html.menu-open{overflow:hidden}
body{background:var(--bg);color:var(--text);font-family:var(--ff);line-height:1.65;overflow-x:hidden;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
ul{list-style:none}
:focus-visible{outline:2px solid var(--cyan);outline-offset:3px;border-radius:6px}
::selection{background:rgba(0,217,255,.3)}
::-webkit-scrollbar{width:10px;height:10px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:#1a2850;border-radius:10px}
::-webkit-scrollbar-thumb:hover{background:var(--blue)}
.ic{width:1.15em;height:1.15em;flex:none;display:inline-block;vertical-align:-.15em}
.sprite{position:absolute;width:0;height:0;overflow:hidden}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.skip{position:absolute;left:12px;top:-60px;background:var(--blue);color:#fff;padding:10px 16px;border-radius:10px;z-index:1000;transition:top .2s}
.skip:focus{top:12px}

/* ---------- Background layers ---------- */
#bg{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
.orb{position:fixed;border-radius:50%;filter:blur(90px);opacity:.26;z-index:0;pointer-events:none}
.orb-a{width:46vmax;height:46vmax;left:-14vmax;top:-12vmax;background:radial-gradient(circle,#2563FF,transparent 65%)}
.orb-b{width:40vmax;height:40vmax;right:-12vmax;bottom:-14vmax;background:radial-gradient(circle,#00D9FF,transparent 65%);opacity:.16}
body::after{content:"";position:fixed;inset:0;pointer-events:none;z-index:2;background:repeating-linear-gradient(0deg,rgba(255,255,255,.016) 0 1px,transparent 1px 3px)}
header,main,footer{position:relative;z-index:1}
.progress{position:fixed;top:0;left:0;height:2px;width:100%;transform-origin:0 50%;transform:scaleX(0);background:var(--grad);box-shadow:0 0 12px var(--cyan);z-index:200}

/* ---------- Custom cursor ---------- */
.cursor-dot,.cursor-ring{position:fixed;left:0;top:0;pointer-events:none;z-index:9999;border-radius:50%;opacity:0;transition:opacity .3s}
.cursor-dot{width:7px;height:7px;margin:-3.5px 0 0 -3.5px;background:var(--cyan);box-shadow:0 0 14px var(--cyan),0 0 30px rgba(0,217,255,.6)}
.cursor-ring{width:38px;height:38px;margin:-19px 0 0 -19px;border:1.5px solid rgba(0,217,255,.55);box-shadow:0 0 20px rgba(0,217,255,.25),inset 0 0 14px rgba(0,217,255,.15);transition:opacity .3s,width .25s,height .25s,margin .25s,background .25s,border-color .25s}
html.has-cursor .cursor-dot,html.has-cursor .cursor-ring{opacity:1}
html.has-cursor.dlg-open .cursor-dot,html.has-cursor.dlg-open .cursor-ring{opacity:0}
html.has-cursor:not(.dlg-open),html.has-cursor:not(.dlg-open) *{cursor:none!important}
.cursor-ring.hot{width:60px;height:60px;margin:-30px 0 0 -30px;background:rgba(0,217,255,.08);border-color:var(--cyan)}
.cursor-ring.down{width:26px;height:26px;margin:-13px 0 0 -13px}

/* ---------- Layout helpers ---------- */
.container{width:min(1200px,100% - 40px);margin-inline:auto}
section{padding:clamp(72px,10vw,120px) 0;position:relative}
.sec-head{margin-bottom:clamp(32px,5vw,56px)}
.eyebrow{font-family:var(--mono);font-size:.78rem;letter-spacing:.18em;color:var(--cyan);text-transform:uppercase;display:inline-flex;gap:.7em;align-items:center}
.eyebrow::before{content:"";width:28px;height:1px;background:var(--cyan);box-shadow:0 0 8px var(--cyan)}
.title{font-family:var(--display);font-size:clamp(1.5rem,3.4vw,2.5rem);line-height:1.2;margin:14px 0 12px;font-weight:700}
.grad{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.lead{color:var(--muted);max-width:640px}

.glass{--mx:50%;--my:50%;--sa:0;position:relative;background:radial-gradient(420px circle at var(--mx) var(--my),rgba(0,217,255,var(--sa)),transparent 60%),linear-gradient(150deg,rgba(13,21,40,.88),rgba(13,21,40,.58));border:1px solid var(--border);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);transition:border-color .3s,box-shadow .3s}
.glass:hover{--sa:.13;border-color:rgba(0,217,255,.45);box-shadow:0 0 36px rgba(0,217,255,.1),0 12px 40px rgba(0,0,0,.35)}
.tilt{transition:transform .18s ease-out,border-color .3s,box-shadow .3s;will-change:transform}

/* reveal */
.js .reveal{opacity:0}
.js .reveal.in{opacity:1;animation:rise .8s cubic-bezier(.2,.8,.2,1) var(--d,0s) backwards}
@keyframes rise{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:none}}

/* ---------- Buttons ---------- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:.6em;padding:.85em 1.5em;border-radius:14px;font-weight:600;font-size:.95rem;border:1px solid transparent;transition:transform .2s,box-shadow .25s,background .25s,border-color .25s,color .25s;white-space:nowrap}
.btn-primary{background:var(--grad);color:#021024}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 32px rgba(37,99,255,.55),0 0 24px rgba(0,217,255,.45)}
.btn-ghost{border-color:var(--border);background:rgba(13,21,40,.55);color:var(--text)}
.btn-ghost:hover{border-color:var(--cyan);box-shadow:0 0 22px rgba(0,217,255,.25);transform:translateY(-2px)}
.btn-sm{padding:.55em 1.1em;font-size:.85rem;border-radius:11px}
.btn[disabled]{opacity:.6;pointer-events:none}
.icon-btn{width:42px;height:42px;display:grid;place-items:center;border-radius:12px;border:1px solid var(--border);background:rgba(13,21,40,.6);transition:.2s;font-size:1.1rem;flex:none}
.icon-btn:hover{border-color:var(--cyan);box-shadow:0 0 18px rgba(0,217,255,.3);color:var(--cyan)}
.icon-btn[aria-pressed="true"]{color:var(--cyan);border-color:rgba(0,217,255,.5)}
.icon-btn .on{display:none}
.icon-btn[aria-pressed="true"] .on{display:block}
.icon-btn[aria-pressed="true"] .off{display:none}
.pulse-hint{animation:hint 1.8s infinite}
@keyframes hint{0%{box-shadow:0 0 0 0 rgba(0,217,255,.55)}100%{box-shadow:0 0 0 14px rgba(0,217,255,0)}}

/* ---------- Navbar ---------- */
.nav{position:fixed;inset:0 0 auto 0;height:var(--nav-h);z-index:100;display:flex;align-items:center;border-bottom:1px solid transparent;transition:background .3s,border-color .3s}
.nav.scrolled{background:rgba(5,8,22,.74);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-color:var(--border)}
.nav .container{display:flex;align-items:center;justify-content:space-between;gap:16px}
.logo{display:flex;align-items:baseline;gap:8px;font-family:var(--display);font-weight:700;white-space:nowrap}
.logo b{color:var(--cyan);font-size:1.35rem;letter-spacing:.04em;text-shadow:0 0 12px var(--cyan),0 0 30px rgba(0,217,255,.5)}
.logo .slash{color:var(--blue);font-size:.95rem}
.logo .lname{color:var(--muted);font-size:.82rem;font-weight:500;display:none}
@media(min-width:520px){.logo .lname{display:inline}}
.nav-links{display:none;gap:2px}
.nav-links a{padding:.5em .8em;border-radius:10px;font-size:.88rem;color:var(--muted);transition:color .2s;position:relative}
.nav-links a:hover,.nav-links a.active{color:var(--text)}
.nav-links a.active::after{content:"";position:absolute;left:.8em;right:.8em;bottom:1px;height:2px;border-radius:2px;background:var(--grad);box-shadow:0 0 10px var(--cyan)}
.nav-tools{display:flex;align-items:center;gap:10px}
.nav-cta{display:none}
.burger{width:42px;height:42px;border-radius:12px;border:1px solid var(--border);display:grid;place-content:center;gap:5px;background:rgba(13,21,40,.6);flex:none}
.burger span{display:block;width:20px;height:2px;background:var(--text);border-radius:2px;transition:transform .3s,opacity .3s}
.burger[aria-expanded="true"] span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.burger[aria-expanded="true"] span:nth-child(2){opacity:0}
.burger[aria-expanded="true"] span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
@media(min-width:1240px){.nav-links{display:flex}.nav-cta{display:inline-flex}.burger{display:none}}

.mobile-menu{position:fixed;inset:0;z-index:99;background:rgba(5,8,22,.97);backdrop-filter:blur(18px);display:flex;flex-direction:column;justify-content:center;gap:4px;padding:calc(var(--nav-h) + 16px) 28px 32px;clip-path:circle(0% at calc(100% - 42px) 36px);visibility:hidden;transition:clip-path .55s cubic-bezier(.7,0,.2,1),visibility 0s .55s;overflow:auto}
.mobile-menu.open{clip-path:circle(150% at calc(100% - 42px) 36px);visibility:visible;transition:clip-path .55s cubic-bezier(.7,0,.2,1),visibility 0s}
.m-link{display:flex;justify-content:space-between;align-items:center;font-family:var(--display);font-size:clamp(1.15rem,4.6vw,1.6rem);padding:.5em 0;border-bottom:1px solid var(--border);opacity:0;transform:translateX(24px);transition:opacity .4s,transform .4s,color .2s}
.m-link small{font-family:var(--mono);color:var(--cyan);font-size:.78rem}
.m-link:hover{color:var(--cyan)}
.mobile-menu.open .m-link,.mobile-menu.open .m-cta{opacity:1;transform:none;transition-delay:calc(var(--i,0)*55ms + 180ms)}
.m-cta{margin-top:22px;opacity:0;transform:translateX(24px);transition:opacity .4s,transform .4s}

/* ---------- Hero ---------- */
.hero{min-height:100svh;display:flex;align-items:center;padding:calc(var(--nav-h) + 36px) 0 72px}
.hero-grid{display:grid;gap:44px;align-items:center}
@media(min-width:980px){.hero-grid{grid-template-columns:1.02fr .98fr}}
.status{display:inline-flex;align-items:center;gap:12px;padding:.5em 1.1em;border:1px solid rgba(34,255,153,.3);background:rgba(34,255,153,.07);border-radius:999px;font-size:.8rem;font-family:var(--mono);color:#9bffd0}
.dot{width:9px;height:9px;border-radius:50%;background:#22ff99;box-shadow:0 0 10px #22ff99;position:relative;flex:none}
.dot::after{content:"";position:absolute;inset:0;border-radius:50%;background:#22ff99;animation:ping 1.8s infinite}
@keyframes ping{0%{transform:scale(1);opacity:.8}100%{transform:scale(3.2);opacity:0}}
.greet{margin:26px 0 12px;font-family:var(--mono);color:var(--muted);font-size:clamp(.95rem,2vw,1.15rem)}
.greet b{color:var(--cyan);font-weight:700}
.hero h1{font-family:var(--display);font-size:clamp(1.9rem,4.8vw,3.5rem);line-height:1.14;font-weight:900}
.hero h1 .grad{background:linear-gradient(90deg,#2563FF,#00D9FF,#7aa2ff,#2563FF);background-size:250% 100%;-webkit-background-clip:text;background-clip:text;animation:shift 8s linear infinite}
@keyframes shift{to{background-position:250% 0}}
.role{margin:20px 0 14px;font-family:var(--mono);font-size:clamp(.92rem,1.8vw,1.1rem);color:var(--muted);min-height:1.8em}
.role .typed{color:var(--text)}
.caret{display:inline-block;width:.6ch;height:1.1em;background:var(--cyan);vertical-align:-.2em;margin-left:3px;animation:blink 1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}
.desc{color:var(--muted);max-width:560px;font-size:1.04rem}
.cta-row{display:flex;flex-wrap:wrap;gap:14px;margin:30px 0 28px}
.socials{display:flex;gap:12px}
.soc{width:46px;height:46px;display:grid;place-items:center;border-radius:14px;border:1px solid var(--border);background:rgba(13,21,40,.55);color:var(--muted);transition:.25s;font-size:1.2rem}
.soc:hover{color:var(--cyan);border-color:var(--cyan);box-shadow:0 0 22px rgba(0,217,255,.35);transform:translateY(-3px)}

/* ---------- Terminal ---------- */
.hero-term{max-width:660px;width:100%;justify-self:center}
.term-wrap{position:relative;border-radius:18px;padding:1px;overflow:hidden;box-shadow:0 20px 80px rgba(37,99,255,.25),0 0 60px rgba(0,217,255,.08);transition:box-shadow .4s}
.term-wrap.flash{box-shadow:0 0 0 2px var(--cyan),0 0 90px rgba(0,217,255,.55)}
.term-wrap::before{content:"";position:absolute;inset:-60%;background:conic-gradient(from 0deg,transparent 0 62%,rgba(0,217,255,.9) 82%,transparent 100%);animation:spin 6s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.term{position:relative;background:linear-gradient(160deg,#0A1226,#070C1C);border-radius:17px;overflow:hidden;font-family:var(--mono);font-size:.82rem}
.term-bar{display:flex;align-items:center;gap:8px;padding:12px 16px;border-bottom:1px solid var(--border);background:rgba(13,21,40,.8)}
.term-bar i{width:11px;height:11px;border-radius:50%;display:block}
.term-bar i:nth-child(1){background:#ff5f57}.term-bar i:nth-child(2){background:#febc2e}.term-bar i:nth-child(3){background:#28c840}
.term-bar span{margin-left:10px;color:var(--muted);font-size:.76rem}
.term-body{height:clamp(300px,44vh,400px);overflow-y:auto;padding:16px;scrollbar-width:thin}
.term-line{white-space:pre-wrap;word-break:break-word;line-height:1.65;color:#cfe0ff}
.term-line.cmd{color:var(--text)}
.term-line .p{color:var(--cyan)}
.term-line.err{color:#ff8aa0}
.term-line.ok{color:#7dffb8}
.term-line.dim{color:var(--muted)}
.term-line a{color:var(--cyan);text-decoration:underline;text-underline-offset:3px}
.term-chips{display:flex;flex-wrap:wrap;gap:8px;padding:0 16px 12px}
.term-chips button{font-family:var(--mono);font-size:.74rem;padding:.3em .8em;border-radius:999px;border:1px solid var(--border);color:var(--muted);transition:.2s}
.term-chips button:hover{color:var(--cyan);border-color:var(--cyan);box-shadow:0 0 14px rgba(0,217,255,.3)}
.term-input{display:flex;gap:8px;align-items:center;padding:12px 16px;border-top:1px solid var(--border);background:rgba(5,8,22,.65)}
.term-input label{color:var(--cyan);white-space:nowrap}
.term-input input{flex:1;min-width:0;background:none;border:0;outline:0;color:var(--text);font:inherit;caret-color:var(--cyan)}

/* ---------- About ---------- */
.about-grid{display:grid;gap:36px}
@media(min-width:960px){.about-grid{grid-template-columns:1.2fr .8fr;align-items:start}}
.about-text p{color:var(--muted);margin-bottom:16px;font-size:1.04rem}
.about-text strong{color:var(--text);font-weight:600}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:28px 0}
.stat{padding:18px 10px;text-align:center;border-radius:16px}
.stat b{display:block;font-family:var(--display);font-size:clamp(1.3rem,3vw,1.9rem);color:var(--cyan);text-shadow:0 0 18px rgba(0,217,255,.45)}
.stat span{font-size:.78rem;color:var(--muted)}
.info-panel{padding:28px;border-radius:20px}
.avatar{width:90px;height:90px;border-radius:50%;display:grid;place-items:center;font-family:var(--display);font-weight:900;font-size:1.7rem;background:radial-gradient(circle at 30% 30%,#13224a,#0A1020);border:1px solid rgba(0,217,255,.4);box-shadow:0 0 30px rgba(0,217,255,.25),inset 0 0 20px rgba(37,99,255,.3);margin-bottom:20px}
.info-panel h3{font-family:var(--mono);font-size:.78rem;color:var(--cyan);letter-spacing:.16em;margin-bottom:10px;font-weight:500}
.info-row{display:flex;justify-content:space-between;gap:16px;padding:13px 0;border-bottom:1px dashed var(--border)}
.info-row span:first-child{color:var(--muted);font-size:.88rem;flex:none}
.info-row span:last-child{text-align:right;font-weight:500;font-size:.94rem}
.info-panel .btn{width:100%;margin-top:24px}
.btn-neon{background:transparent;border-color:var(--cyan);color:var(--cyan);box-shadow:0 0 18px rgba(0,217,255,.25),inset 0 0 18px rgba(0,217,255,.08)}
.btn-neon:hover{background:rgba(0,217,255,.12);color:#fff;box-shadow:0 0 34px rgba(0,217,255,.6),inset 0 0 22px rgba(0,217,255,.2);transform:translateY(-2px)}

/* ---------- Skills ---------- */
.skills-grid{display:grid;gap:24px}
@media(min-width:900px){.skills-grid{grid-template-columns:repeat(3,1fr)}}
.skill-card{padding:26px;border-radius:20px;display:flex;flex-direction:column;gap:20px}
.skill-card header{display:flex;align-items:center;gap:14px}
.skill-ico{width:46px;height:46px;border-radius:13px;display:grid;place-items:center;background:rgba(37,99,255,.16);border:1px solid var(--border);color:var(--cyan);font-size:1.3rem}
.skill-card h3{font-size:1.1rem;line-height:1.25}
.skill-card header small{display:block;color:var(--muted);font-size:.74rem;font-family:var(--mono)}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.skill-chip{padding:.42em .85em;border-radius:10px;border:1px solid var(--border);background:rgba(10,16,32,.8);font-size:.84rem;color:var(--muted);transition:.2s}
.skill-chip:hover,.skill-chip:focus-visible,.skill-chip.on{color:#fff;border-color:var(--cyan);background:rgba(0,217,255,.09);box-shadow:0 0 16px rgba(0,217,255,.45),inset 0 0 12px rgba(0,217,255,.12);transform:translateY(-2px)}
.code-panel{margin-top:auto;border-radius:14px;background:#070C1C;border:1px solid var(--border);overflow:hidden}
.code-head{display:flex;justify-content:space-between;align-items:center;padding:9px 14px;font-family:var(--mono);font-size:.72rem;color:var(--muted);border-bottom:1px solid var(--border)}
.code-head b{color:var(--cyan);font-weight:500}
.lvl{height:3px;background:rgba(120,160,255,.14)}
.lvl i{display:block;height:100%;width:0;background:var(--grad);box-shadow:0 0 10px var(--cyan);transition:width .6s cubic-bezier(.2,.8,.2,1)}
.code-panel pre{padding:14px;font-family:var(--mono);font-size:.74rem;line-height:1.75;color:#cfe0ff;height:132px;overflow:auto;white-space:pre}
.code-panel pre.flash{animation:codeIn .3s}
@keyframes codeIn{from{opacity:.25;transform:translateY(4px)}to{opacity:1;transform:none}}
.k{color:#7aa2ff}.s{color:#7dffb8}.n{color:#ffd277}.c{color:#5d6d93;font-style:italic}

/* ---------- Projects ---------- */
.filters{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:34px}
.filter{padding:.55em 1.15em;border-radius:999px;border:1px solid var(--border);background:rgba(13,21,40,.6);color:var(--muted);font-size:.88rem;transition:.2s}
.filter:hover{color:var(--text);border-color:rgba(0,217,255,.5)}
.filter[aria-pressed="true"]{background:var(--grad);color:#021024;border-color:transparent;font-weight:600;box-shadow:0 0 24px rgba(0,217,255,.35)}
.projects-grid{display:grid;gap:24px;grid-template-columns:repeat(auto-fill,minmax(min(100%,340px),1fr))}
.project{border-radius:20px;overflow:hidden;display:flex;flex-direction:column}
.project.is-hidden{display:none}
.project.pop{animation:pop .5s both}
@keyframes pop{from{opacity:0;transform:scale(.94) translateY(12px)}to{opacity:1;transform:none}}
.project-vis{aspect-ratio:16/9;background:#07102a;border-bottom:1px solid var(--border);overflow:hidden}
.project-vis svg{width:100%;height:100%;display:block;transition:transform .6s}
.project:hover .project-vis svg{transform:scale(1.06)}
.project-body{padding:22px;display:flex;flex-direction:column;gap:12px;flex:1}
.badge{align-self:flex-start;font-family:var(--mono);font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;color:var(--cyan);border:1px solid rgba(0,217,255,.3);padding:.25em .75em;border-radius:999px}
.project h3{font-size:1.18rem;line-height:1.3}
.project p{color:var(--muted);font-size:.92rem}
.tags{display:flex;flex-wrap:wrap;gap:6px}
.tags li{font-family:var(--mono);font-size:.71rem;padding:.25em .6em;border-radius:6px;background:rgba(37,99,255,.14);color:#a9c1ff}
.project-actions{margin-top:auto;display:flex;flex-wrap:wrap;align-items:center;gap:6px 18px;padding-top:8px}
.linkbtn{display:inline-flex;align-items:center;gap:6px;font-size:.85rem;color:var(--muted);padding:.35em 0;transition:color .2s}
.linkbtn:hover{color:var(--cyan)}
.project-actions .btn{flex-basis:100%;margin-top:6px}

/* ---------- Dialogs ---------- */
dialog{border:0;background:transparent;color:var(--text);padding:0;margin:0;inset:0;width:100%;height:100%;max-width:none;max-height:none;overflow:auto}
dialog::backdrop{background:rgba(2,4,12,.8);backdrop-filter:blur(8px)}
dialog[open]{display:grid;place-items:center;padding:20px;animation:fadeIn .25s}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.dlg-panel{position:relative;width:min(860px,100%);max-height:calc(100dvh - 40px);overflow:auto;border-radius:22px;padding:clamp(22px,4vw,40px);background:linear-gradient(160deg,#0D1528,#080e20);border:1px solid rgba(0,217,255,.28);box-shadow:0 30px 120px rgba(0,0,0,.6),0 0 60px rgba(37,99,255,.2)}
.dlg-close{position:absolute;top:14px;right:14px;z-index:3}
.case h3{font-family:var(--display);font-size:clamp(1.25rem,3vw,1.75rem);margin:12px 0 8px;padding-right:48px;line-height:1.25}
.case h4{font-family:var(--mono);font-size:.76rem;letter-spacing:.16em;text-transform:uppercase;color:var(--cyan);margin:26px 0 10px;font-weight:500}
.case p,.case li{color:var(--muted)}
.case-meta{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));margin:20px 0 4px;padding:16px;border:1px solid var(--border);border-radius:14px;background:rgba(5,8,22,.5)}
.case-meta small{display:block;font-family:var(--mono);font-size:.66rem;color:var(--muted);letter-spacing:.14em}
.case-meta b{font-weight:600;font-size:.9rem}
.flow{display:flex;flex-wrap:wrap;align-items:center;gap:8px}
.flow span{padding:.55em 1em;border-radius:12px;border:1px solid rgba(0,217,255,.35);background:rgba(0,217,255,.06);font-family:var(--mono);font-size:.78rem}
.flow i{color:var(--cyan);font-style:normal}
.check li{position:relative;padding-left:22px;margin:8px 0}
.check li::before{content:"▹";position:absolute;left:0;color:var(--cyan)}
.case-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}

/* ---------- Process ---------- */
.process-grid{display:grid;gap:20px;grid-template-columns:repeat(auto-fit,minmax(min(100%,250px),1fr))}
.step{padding:28px;border-radius:20px;overflow:hidden}
.step::after{content:"";position:absolute;left:0;right:0;top:0;height:2px;background:var(--grad);box-shadow:0 0 12px var(--cyan);transform:scaleX(0);transform-origin:left;transition:transform .5s}
.step:hover::after{transform:scaleX(1)}
.step .num{font-family:var(--display);font-size:2.6rem;font-weight:900;line-height:1;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.step h3{margin:14px 0 8px;font-size:1.1rem}
.step p{color:var(--muted);font-size:.93rem}

/* ---------- Timeline ---------- */
.timeline{position:relative;max-width:860px;margin-inline:auto;padding-left:34px}
.timeline::before{content:"";position:absolute;left:8px;top:6px;bottom:6px;width:2px;background:linear-gradient(var(--cyan),var(--blue),transparent);box-shadow:0 0 12px rgba(0,217,255,.5)}
.t-item{padding:24px 26px;border-radius:18px;margin-bottom:22px}
.t-item::before{content:"";position:absolute;left:-34px;top:30px;width:18px;height:18px;border-radius:50%;background:var(--bg);border:2px solid var(--cyan);box-shadow:0 0 16px var(--cyan)}
.t-meta{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-bottom:8px;font-family:var(--mono);font-size:.76rem}
.t-type{padding:.2em .75em;border-radius:999px;border:1px solid rgba(0,217,255,.35);color:var(--cyan)}
.t-type.edu{border-color:rgba(37,99,255,.7);color:#8fb0ff}
.t-type.proj{border-color:rgba(154,168,199,.5);color:var(--muted)}
.t-date{color:var(--muted)}
.t-item h3{font-size:1.1rem}
.t-org{color:#a9c1ff;font-size:.92rem;margin-bottom:8px}
.t-item p{color:var(--muted);font-size:.93rem}

/* ---------- Services ---------- */
.services-grid{display:grid;gap:22px;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr))}
.service{padding:30px;border-radius:20px;display:flex;flex-direction:column;gap:12px}
.s-ico{width:54px;height:54px;border-radius:16px;display:grid;place-items:center;background:linear-gradient(135deg,rgba(37,99,255,.3),rgba(0,217,255,.15));border:1px solid rgba(0,217,255,.3);color:var(--cyan);font-size:1.5rem;box-shadow:0 0 24px rgba(37,99,255,.25)}
.service h3{font-size:1.08rem;line-height:1.35}
.service p{color:var(--muted);font-size:.92rem}
.more{margin-top:auto;padding-top:6px;color:var(--cyan);font-size:.88rem;display:inline-flex;gap:6px;align-items:center;transition:gap .2s}
.more:hover{gap:12px}

/* ---------- Contact ---------- */
.contact-grid{display:grid;gap:32px}
@media(min-width:960px){.contact-grid{grid-template-columns:.85fr 1.15fr;align-items:start}}
.contact-info .lead{margin-bottom:26px}
.c-list{display:grid;gap:12px}
.c-row{display:flex;align-items:center;gap:14px;padding:14px 16px;border-radius:14px;transition:.2s}
.c-row .ci{width:40px;height:40px;border-radius:11px;display:grid;place-items:center;background:rgba(37,99,255,.16);color:var(--cyan);flex:none}
.c-row small{display:block;color:var(--muted);font-size:.72rem;font-family:var(--mono)}
.c-row span.v{font-size:.95rem;word-break:break-all}
.c-row .grow{flex:1;min-width:0}
.c-row .icon-btn{width:38px;height:38px}
.form{padding:clamp(22px,4vw,36px);border-radius:22px;display:grid;gap:18px}
.two{display:grid;gap:18px}
@media(min-width:620px){.two{grid-template-columns:1fr 1fr}}
.field{display:grid;gap:6px;border:0;min-width:0}
.field label,.field legend{font-size:.82rem;color:var(--muted);font-family:var(--mono)}
.field input[type=text],.field input[type=email],.field textarea{width:100%;background:rgba(5,8,22,.7);border:1px solid var(--border);border-radius:12px;padding:.85em 1em;color:var(--text);font:inherit;outline:0;transition:.2s}
.field input:focus,.field textarea:focus{border-color:var(--cyan);box-shadow:0 0 0 3px rgba(0,217,255,.14),0 0 20px rgba(0,217,255,.18)}
.field textarea{min-height:140px;resize:vertical}
.field.invalid input,.field.invalid textarea{border-color:#ff5a78}
.err{color:#ff8aa0;font-size:.78rem;min-height:1.1em}
.counter{justify-self:end;font-size:.72rem;color:var(--muted);font-family:var(--mono)}
.budget{display:flex;flex-wrap:wrap;gap:10px;margin-top:6px}
.budget label{position:relative;font-family:var(--ff);font-size:inherit;color:inherit}
.budget input{position:absolute;opacity:0;inset:0;width:100%;height:100%;margin:0;cursor:pointer}
.budget span{display:inline-block;padding:.55em 1em;border-radius:12px;border:1px solid var(--border);font-size:.86rem;color:var(--muted);transition:.2s}
.budget label:hover span{border-color:rgba(0,217,255,.5)}
.budget input:checked+span{border-color:var(--cyan);color:#fff;background:rgba(0,217,255,.1);box-shadow:0 0 18px rgba(0,217,255,.3)}
.budget input:focus-visible+span{outline:2px solid var(--cyan);outline-offset:2px}
.hp{position:absolute;left:-9999px;width:1px;height:1px;opacity:0}

/* ---------- Toasts ---------- */
.toasts{position:fixed;right:20px;bottom:20px;z-index:2000;display:grid;gap:10px;max-width:min(380px,calc(100vw - 40px))}
.toast{display:flex;gap:12px;align-items:flex-start;padding:14px 16px;border-radius:14px;background:rgba(10,16,32,.96);border:1px solid var(--border);backdrop-filter:blur(12px);box-shadow:0 12px 40px rgba(0,0,0,.5);animation:toastIn .4s cubic-bezier(.2,.8,.2,1);font-size:.9rem}
.toast.success{border-color:rgba(34,255,153,.5);box-shadow:0 0 30px rgba(34,255,153,.14),0 12px 40px rgba(0,0,0,.5)}
.toast.error{border-color:rgba(255,90,120,.55)}
.toast.info{border-color:rgba(0,217,255,.4)}
.toast .t-ic{flex:none;font-weight:700}
.toast.success .t-ic{color:#22ff99}.toast.error .t-ic{color:#ff5a78}.toast.info .t-ic{color:var(--cyan)}
.toast.out{animation:toastOut .3s forwards}
@keyframes toastIn{from{opacity:0;transform:translateY(16px) scale(.96)}to{opacity:1;transform:none}}
@keyframes toastOut{to{opacity:0;transform:translateX(30px)}}

/* ---------- Footer ---------- */
footer{border-top:1px solid var(--border);background:rgba(5,8,22,.72);padding:40px 0}
.foot{display:flex;flex-wrap:wrap;gap:20px;justify-content:space-between;align-items:center}
.foot p{color:var(--muted);font-size:.9rem}
.foot-actions{display:flex;gap:12px;flex-wrap:wrap}

/* ---------- Game ---------- */
.game-panel{width:min(560px,100%);text-align:center;padding-top:clamp(22px,4vw,34px)}
.game-hud{display:flex;justify-content:space-between;gap:8px;font-family:var(--mono);font-size:.74rem;color:var(--muted);margin:2px 0 12px;padding-right:46px;text-align:left}
.game-hud b{color:var(--cyan);font-weight:700}
#game{display:block;margin:0 auto;border-radius:14px;border:1px solid rgba(0,217,255,.35);background:#03050f;box-shadow:0 0 40px rgba(0,217,255,.18);width:min(100%,calc(min(60dvh,600px)*.75));height:auto;aspect-ratio:3/4;touch-action:none}
.pad{display:flex;justify-content:center;gap:12px;margin-top:14px}
.pad button{min-width:74px;height:52px;padding:0 16px;border-radius:14px;border:1px solid var(--border);background:rgba(13,21,40,.8);font-size:1rem;user-select:none;-webkit-user-select:none;touch-action:none;transition:.1s}
.pad button.down{border-color:var(--cyan);box-shadow:0 0 18px rgba(0,217,255,.5);background:rgba(0,217,255,.14)}
.game-help{font-size:.72rem;color:var(--muted);margin-top:12px;font-family:var(--mono);line-height:1.6}

/* ---------- Responsive & a11y ---------- */
@media(max-width:640px){
  .term-body{height:290px}
  .stats{gap:10px}
  .t-item{padding:20px}
  .toasts{right:12px;left:12px;bottom:12px;max-width:none}
}
@media(pointer:coarse){input,textarea{font-size:16px!important}}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}
  .term-wrap::before{animation:none}
  .caret{animation:none}
}
</style>
